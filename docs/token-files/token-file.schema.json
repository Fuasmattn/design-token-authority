                    "properties": {
                      "WEB": {
                        "type": "string"
                      },
                      "ANDROID": {
                        "type": "string"
                      },
                      "iOS": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": {}
                  }
                },
                "additionalProperties": {},
                "description": "Figma-specific variable metadata, kept when pushing to Figma."
              }
            },
            "additionalProperties": {}
          }
