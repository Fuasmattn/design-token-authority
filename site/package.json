{
  "name": "dta-site",
  "version": "0.0.0",
  "private": true,
  "description": "The Design Token Authority website (Astro + Starlight); its design tokens are built with DTA",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "tokens": "node ../bin/dta.js build && tsx scripts/build-example.ts",
    "dev": "pnpm tokens && pnpm reference && astro dev",
    "build": "pnpm tokens && pnpm reference && astro build",
    "preview": "astro preview",
    "typecheck": "pnpm tokens && pnpm reference && astro check",
    "test": "vitest run",
    "test:contrast": "DTA_E2E=1 vitest run contrast.e2e.test.ts",
    "report:tokens": "tsx scripts/report-tokens.ts",
    "reference": "tsx scripts/generate-reference.ts"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/starlight": "0.42.5",
    "@dta/build": "workspace:*",
    "@dta/cli": "workspace:*",
    "@dta/core": "workspace:*",
    "@dta/lint": "workspace:*",
    "@types/node": "^24.12.2",
    "playwright-core": "1.59.1",
    "astro": "7.3.5",
    "starlight-links-validator": "0.26.0",
    "typescript": "^5.1.6",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/martian-mono": "5.3.0"
  }
}
