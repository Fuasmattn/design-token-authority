{
  "color": {
    "$description": "The raw palette. Groups can carry a description too.",
    "blue": {
      "500": {
        "$type": "color",
        "$value": "#2f6bd8",
        "$description": "Links and primary actions"
      },
      "700": {
        "$type": "color",
        "$value": "#1d4597"
      }
    },
    "link": {
      "$type": "color",
      "$value": "{color.blue.500}"
    }
  },
  "space": {
    "4": {
      "$type": "number",
      "$value": 4,
      "$extensions": {
        "com.figma": {
          "scopes": ["GAP"]
        }
      }
    },
    "8": {
      "$type": "number",
      "$value": 8,
      "$extensions": {
        "com.figma": {
          "scopes": ["GAP"]
        }
      }
    }
  },
  "font": {
    "body": {
      "$type": "string",
      "$value": "Instrument Sans, sans-serif"
    }
  },
  "motion": {
    "enabled": {
      "$type": "boolean",
      "$value": true,
      "$extensions": {
        "com.figma": {
          "scopes": ["ALL_SCOPES"]
        }
      }
    }
  }
}
