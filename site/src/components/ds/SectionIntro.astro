---
/**
 * The head of a landing-page section: an optional mono kicker, a condensed display heading, one lede
 * and, when the section points somewhere, one link. The same shape above the workflow and
 * above the example, so the sections read as siblings (TICKET-155).
 */
import ArrowLink from './ArrowLink.astro'

interface Props {
  /** Mono eyebrow above the heading; leave out when the heading stands on its own. */
  kicker?: string
  heading: string
  lede?: string
  link?: { label: string; href: string }
  /** The heading's id, for `aria-labelledby` on the section. */
  headingId?: string
}
const { kicker, heading, lede, link, headingId } = Astro.props
---

<div class="dta-section-intro">
  {kicker && <span class="kicker">{kicker}</span>}
  <h2 id={headingId}>{heading}</h2>
  {lede && <p class="lede">{lede}</p>}
  {
    link && (
      <span class="link">
        <ArrowLink href={link.href}>{link.label}</ArrowLink>
      </span>
    )
  }
</div>

<style>
  .dta-section-intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    color: var(--fg-default);
    font-family: var(--font-sans);
  }
  .kicker {
    font-family: var(--font-mono);
    font-size: calc(var(--type-meta-size) * 1px);
    line-height: var(--type-meta-line-height);
    letter-spacing: var(--type-meta-letter-spacing);
    text-transform: uppercase;
    color: var(--action-text);
  }
  h2 {
    margin: 0;
    max-width: 24ch;
    text-wrap: balance;
    /* A step below the hero headline at every width */
    font-size: clamp(
      calc(var(--type-heading-size) * 1px * 0.8),
      3.2vw,
      calc(var(--type-display-lg-size) * 1px * 0.8)
    );
    font-weight: var(--type-display-lg-weight);
    line-height: var(--type-display-lg-line-height);
    letter-spacing: var(--type-display-lg-letter-spacing);
    font-stretch: 85%;
  }
  .lede {
    margin: 0;
    max-width: 44ch;
    /* Never larger than the hero's subline: the same on phones, a step below on desktop */
    font-size: calc(var(--type-body-size) * 1px);
    line-height: var(--type-body-line-height);
    color: var(--fg-muted);
  }
  .link {
    margin-top: var(--space-1);
  }
  @media (max-width: 760px) {
    .lede {
      font-size: calc(var(--type-body-size) * 1px * 0.95);
    }
  }
</style>
