---
/** The DTA mark and wordmark: an outlined and a filled rounded square, then "dta". */
interface Props {
  href?: string
}
const { href = '/' } = Astro.props
---

<a href={href} class="dta-logo" aria-label="dta, home">
  <span class="mark" aria-hidden="true"><span class="outline"></span><span class="fill"></span></span>
  dta
</a>

<style>
  .dta-logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    color: var(--fg-default);
    font-family: var(--font-sans);
    font-size: calc(var(--type-title-size) * 1px);
    font-weight: var(--type-title-weight);
    line-height: var(--type-title-line-height);
    text-decoration: none;
  }
  .mark {
    position: relative;
    width: 28px;
    height: 24px;
  }
  .outline,
  .fill {
    position: absolute;
    width: 20px;
    height: 20px;
    border-radius: var(--radius-sm);
  }
  .outline {
    left: 0;
    top: 4px;
    border: var(--stroke-ink) solid var(--border-strong);
  }
  .fill {
    left: 8px;
    top: 0;
    background: var(--action-bg);
    opacity: 0.9;
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .dta-logo:hover .fill {
    transform: translate(-4px, 4px);
  }
  .dta-logo:focus-visible {
    outline: none;
    border-radius: var(--radius-sm);
    box-shadow: 0 0 0 var(--stroke-focus) var(--action-subtle);
  }
  @media (prefers-reduced-motion: reduce) {
    .fill {
      transition: none;
    }
  }
</style>
