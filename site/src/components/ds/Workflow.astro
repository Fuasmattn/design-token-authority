---
/**
 * The workflow at a glance (TICKET-174): what runs on a token change, as four boxes with one
 * sentence each. The three commands are the titles of their boxes, so nothing is named that the
 * tool does not do; the last box is the person who approves, outlined. One link to the command
 * reference closes the section. No motion.
 *
 * Two columns on phones, four from 960px of container.
 */
import SectionIntro from './SectionIntro.astro'

export interface Step {
  /** The command that runs, without the prompt (`dta lint`). Leave out for the person's step. */
  command?: string
  /** Who acts, for the step without a command (`You`). */
  who?: string
  /** One sentence. */
  text: string
}

interface Props {
  title: string
  kicker?: string
  lede?: string
  steps: Step[]
  /** One sentence after the boxes, before the links. */
  note?: string
  /** Links after the boxes (the command reference, a guide). */
  links?: Array<{ label: string; href: string }>
  id?: string
  idPrefix?: string
}
const { title, kicker, lede, steps, note, links = [], id, idPrefix = 'workflow' } = Astro.props
const headingId = `${idPrefix}-title`
---

<section class="dta-workflow-frame" id={id} aria-labelledby={headingId}>
  <div class="intro">
    <SectionIntro kicker={kicker} heading={title} lede={lede} headingId={headingId} />
  </div>
  <ol class="steps">
    {
      steps.map((step) => (
        <li class:list={['step', { person: !step.command }]}>
          {step.command ? (
            <code class="command">
              <span class="prompt" aria-hidden="true">
                ${' '}
              </span>
              {step.command}
            </code>
          ) : (
            <span class="who">{step.who}</span>
          )}
          <p>{step.text}</p>
        </li>
      ))
    }
  </ol>
  {
    (note || links.length > 0) && (
      <div class="outro">
        {note && <p class="note">{note}</p>}
        {links.length > 0 && (
          <div class="links">
            {links.map((link) => (
              <a class="link" href={link.href}>
                {link.label}
                <svg viewBox="0 0 24 12" aria-hidden="true">
                  <path d="M1 6h21M17 1.5 22 6l-5 4.5" />
                </svg>
              </a>
            ))}
          </div>
        )}
      </div>
    )
  }
</section>

<style>
  .dta-workflow-frame {
    container-type: inline-size;
    color: var(--fg-default);
    font-family: var(--font-sans);
  }
  .intro {
    margin-bottom: var(--space-12);
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .step {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-6) var(--space-4) var(--space-6) var(--space-6);
    background: var(--bg-surface);
    border: var(--stroke-hairline) solid var(--border-default);
    border-radius: var(--radius-lg);
  }
  .step.person {
    border: var(--stroke-ink) solid var(--border-strong);
  }
  .command {
    font-family: var(--font-mono);
    font-size: calc(var(--type-code-size) * 1px);
    line-height: var(--type-code-line-height);
    font-weight: 500;
    color: var(--fg-default);
    white-space: nowrap;
  }
  .prompt {
    color: var(--signal-text);
  }
  .who {
    font-size: calc(var(--type-title-size) * 1px * 0.8);
    line-height: calc(var(--type-code-size) * var(--type-code-line-height) * 1px);
    font-weight: var(--type-title-weight);
    color: var(--action-text);
  }
  .step p {
    margin: 0;
    font-size: calc(var(--type-body-sm-size) * 1px * 1.08);
    line-height: var(--type-body-sm-line-height);
    color: var(--fg-default);
  }
  /* After the boxes: one sentence, then the links (the section intro's link style) */
  .outro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-6);
    margin-top: var(--space-12);
  }
  .note {
    margin: 0;
    max-width: var(--layout-measure);
    font-size: calc(var(--type-body-size) * 1px);
    line-height: var(--type-body-line-height);
    color: var(--fg-muted);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-8);
  }
  .link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: calc(var(--type-label-size) * 1px);
    font-weight: var(--type-label-weight);
    line-height: var(--type-label-line-height);
    color: var(--action-text);
    text-decoration: none;
    border-bottom: var(--stroke-hairline) solid transparent;
    transition: border-color var(--motion-duration-fast) var(--motion-ease-standard);
  }
  .link:hover,
  .link:focus-visible {
    border-color: var(--action-text);
  }
  .link svg {
    width: var(--space-6);
    height: var(--space-3);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* The sentence after the boxes matches the section's lede (SectionIntro) */
  @media (max-width: 760px) {
    .note {
      font-size: calc(var(--type-body-size) * 1px * 0.95);
    }
  }

  @container (min-width: 960px) {
    .steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-4);
    }
    .step p {
      font-size: calc(var(--type-body-size) * 1px);
      line-height: var(--type-body-line-height);
    }
  }
</style>
