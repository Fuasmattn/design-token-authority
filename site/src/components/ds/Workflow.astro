---
/**
 * The workflow at a glance (TICKET-155): three beats on one faint line — where design happens,
 * in the pull request, the decision — and the token travelling it once. The token is the hero's
 * orange cube; it breathes a little while it waits at a station. Dust from the hero flows along
 * the line on its own, each mote at its own pace, for as long as the page is open, and bends toward
 * the token when it passes near it, as the hero's objects bend toward the well. Stations fill
 * as the token passes; at the decision it steps back once (an iteration without a loop); at the
 * end the end dot fills and gets its tick: merged. The step back carries no label.
 *
 * The run starts once, when the section scrolls into view, and never loops. Under
 * `prefers-reduced-motion` the finished picture is shown. The line is a polyline through the
 * stations, measured after layout, so one component serves both the stacked (phone) and the
 * three-column (desktop) layout.
 */
import SectionIntro from './SectionIntro.astro'

export interface Beat {
  /** Mono eyebrow: where this happens. */
  where: string
  /** A few words. */
  title: string
  /** Two short sentences. */
  text: string
}

interface Props {
  /** Read by screen readers as the section's heading; shown when `kicker` is set. */
  title: string
  kicker?: string
  lede?: string
  beats: Beat[]
  /** The end state. */
  end: string
  /** Seconds for one run. */
  duration?: number
  id?: string
  idPrefix?: string
}
const {
  title,
  kicker,
  lede,
  beats,
  end,
  duration = 28,
  id,
  idPrefix = 'workflow',
} = Astro.props
const headingId = `${idPrefix}-title`
const DUST = ['s', 'd', 'd2', 'd2', 'd2', 'd', 'd2', 's2', 'd2', 'd', 'd2', 'd2']
---

<section class="dta-workflow-frame" id={id} aria-labelledby={headingId}>
  {
    kicker ? (
      <div class="intro">
        <SectionIntro kicker={kicker} heading={title} lede={lede} headingId={headingId} />
      </div>
    ) : (
      <h2 class="visually-hidden" id={headingId}>
        {title}
      </h2>
    )
  }
  <div class="flow" data-flow data-duration={duration}>
    <svg class="line" aria-hidden="true">
      <path data-path d=""></path>
      <circle class="end" data-end r="7"></circle>
      <circle class="halo" data-halo r="13"></circle>
      <path class="tick" data-tick d=""></path>
    </svg>
    <ol class="beats">
      {
        beats.map((beat) => (
          <li class="beat">
            <span class="station" data-station aria-hidden="true" />
            <span class="where">{beat.where}</span>
            <h3>{beat.title}</h3>
            <p>{beat.text}</p>
          </li>
        ))
      }
    </ol>
    <span class="end-label" data-end-label>{end}</span>
    {DUST.map((kind) => <i class:list={['dust', kind]} data-dust aria-hidden="true" />)}
    <span class="cube orange" data-token aria-hidden="true">
      <span class="spin" data-spin>
        <i></i><i></i><i></i><i></i><i></i><i></i>
      </span>
    </span>
  </div>
</section>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)')

  for (const flow of document.querySelectorAll<HTMLElement>('[data-flow]')) {
    const path = flow.querySelector<SVGPathElement>('[data-path]')!
    const endDot = flow.querySelector<SVGCircleElement>('[data-end]')!
    const halo = flow.querySelector<SVGCircleElement>('[data-halo]')!
    const tick = flow.querySelector<SVGPathElement>('[data-tick]')!
    const endLabel = flow.querySelector<HTMLElement>('[data-end-label]')!
    const token = flow.querySelector<HTMLElement>('[data-token]')!
    const spin = flow.querySelector<HTMLElement>('[data-spin]')!
    const stations = [...flow.querySelectorAll<HTMLElement>('[data-station]')]
    const dust = [...flow.querySelectorAll<HTMLElement>('[data-dust]')]
    const duration = Number(flow.dataset.duration) * 1000
    const beats = flow.querySelector<HTMLElement>('.beats')!

    /** Station centres, the end point and the polyline through them, from the laid-out DOM. */
    let marks: number[] = []
    let total = 0
    function layout() {
      const box = flow.getBoundingClientRect()
      const row = getComputedStyle(beats).flexDirection === 'row'
      const centers = stations.map((s) => {
        const r = s.getBoundingClientRect()
        return { x: r.left - box.left + r.width / 2, y: r.top - box.top + r.height / 2 }
      })
      const last = centers[centers.length - 1]
      // the end sits one beat-gap past the last station, along the flow's direction
      const lastBeat = stations[stations.length - 1].parentElement!.getBoundingClientRect()
      const end = row
        ? { x: lastBeat.right - box.left + 48, y: last.y }
        : { x: last.x, y: lastBeat.bottom - box.top + 56 }
      const points = [...centers, end]
      path.setAttribute('d', points.map((p, i) => `${i ? 'L' : 'M'} ${p.x} ${p.y}`).join(' '))
      endDot.setAttribute('cx', String(end.x))
      endDot.setAttribute('cy', String(end.y))
      halo.setAttribute('cx', String(end.x))
      halo.setAttribute('cy', String(end.y))
      tick.setAttribute(
        'd',
        `M ${end.x - 3.5} ${end.y + 0.5} L ${end.x - 1} ${end.y + 3} L ${end.x + 3.5} ${end.y - 2.5}`,
      )
      endLabel.style.translate = row ? `${end.x - 10}px ${end.y + 16}px` : `${end.x + 32}px ${end.y - 8}px`
      total = path.getTotalLength()
      marks = centers.map((c) => {
        // position along the path: the first point of the polyline nearest the station
        let best = 0
        let bestD = Infinity
        for (let l = 0; l <= total; l += 2) {
          const p = path.getPointAtLength(l)
          const d = (p.x - c.x) ** 2 + (p.y - c.y) ** 2
          if (d < bestD) {
            bestD = d
            best = l
          }
        }
        return best
      })
      return row
    }
    let row = layout()

    // Dust flows along the line on its own, each mote with its own pace, offset and sway, as long as the page is open.
    const motes = dust.map((d, k) => ({
      el: d,
      at: Math.random(),
      speed: 0.012 + Math.random() * 0.02,
      sway: 4 + Math.random() * 8,
      phase: Math.random() * Math.PI * 2,
      side: (k % 3 - 1) * 5,
    }))
    let flowing = false
    // The token pulls the dust that comes near it, like the well pulls the objects in the hero:
    // within `PULL` px a mote bends toward the token, strongest close in, and never quite reaches it.
    const PULL = 56
    let tokenAt: { x: number; y: number } | null = null
    const placeDust = (dt: number) => {
      for (const m of motes) {
        m.at = (m.at + m.speed * dt) % 1
        const q = path.getPointAtLength(m.at * total)
        const sway = Math.sin(m.at * Math.PI * 6 + m.phase) * m.sway
        let x = row ? q.x : q.x + sway + m.side
        let y = row ? q.y + sway + m.side : q.y
        if (tokenAt) {
          const dx = tokenAt.x - x
          const dy = tokenAt.y - y
          const d = Math.hypot(dx, dy)
          if (d < PULL && d > 0) {
            const k = (1 - d / PULL) ** 2 * 0.7
            x += dx * k
            y += dy * k
            // keep a small clearance around the cube
            const nd = Math.hypot(tokenAt.x - x, tokenAt.y - y)
            if (nd < 12) {
              x = tokenAt.x - ((tokenAt.x - x) / nd) * 12
              y = tokenAt.y - ((tokenAt.y - y) / nd) * 12
            }
          }
        }
        const fade = Math.min(1, m.at * 12, (1 - m.at) * 12)
        m.el.style.opacity = String(0.8 * fade)
        m.el.style.transform = `translate(${x}px, ${y}px)`
      }
    }
    let lastDust = 0
    const dustFrame = (now: number) => {
      const dt = lastDust ? Math.min(0.05, (now - lastDust) / 1000) : 0
      lastDust = now
      placeDust(dt)
      if (flowing) requestAnimationFrame(dustFrame)
    }
    const startDust = () => {
      if (flowing) return
      flowing = true
      requestAnimationFrame(dustFrame)
    }

    function finish() {
      stations.forEach((s) => s.classList.add('passed'))
      flow.classList.add('done')
      const p = path.getPointAtLength(total)
      tokenAt = { x: p.x, y: p.y }
      token.style.opacity = '1'
      token.style.transform = `translate(${p.x}px, ${p.y}px)`
    }

    if (reduce.matches) {
      // the finished picture at once: no transitions to run (motion.e2e counts running animations)
      flow.classList.add('still')
      finish()
      placeDust(0)
    } else {
      // The run: move to a point (eased) or rest there, each with a share of the time.
      type Seg = { to?: number; rest?: number; w: number }
      let ran = false
      let running = false
      const COLORS = ['orange', 'blue', 'ink']
      function run() {
        if (running) return
        running = true
        ran = true
        row = layout()
        startDust()
        stations.forEach((s) => s.classList.remove('passed'))
        flow.classList.remove('done')
        const P = [0, ...marks, total]
        const seg: Seg[] = [
          { to: P[1], w: 0.14 },
          { rest: 1, w: 0.04 },
          { to: P[2], w: 0.14 },
          { rest: 2, w: 0.22 },
          { to: P[3], w: 0.12 },
          { rest: 3, w: 0.08 },
          { to: P[2] + (P[3] - P[2]) * 0.3, w: 0.07 },
          { to: P[3], w: 0.07 },
          { rest: 3, w: 0.04 },
          { to: P[4], w: 0.1 },
          { rest: 4, w: 0.08 },
        ]
        const sum = seg.reduce((s, x) => s + x.w, 0)
        for (const s of seg) s.w /= sum
        const at = (t: number) => {
          let acc = 0
          let pos = 0
          for (let i = 0; i < seg.length; i++) {
            const S = seg[i]
            if (t < acc + S.w) {
              const u = (t - acc) / S.w
              if (S.rest) return { pos, rest: S.rest, u, moving: false }
              const e = u < 0.5 ? 2 * u * u : 1 - (-2 * u + 2) ** 2 / 2
              return { pos: pos + (S.to! - pos) * e, rest: 0, u, moving: true }
            }
            acc += S.w
            if (!S.rest) pos = S.to!
          }
          return { pos: total, rest: 4, u: 1, moving: false }
        }
        const t0 = performance.now()
        let ang = 0
        const dir = Math.random() < 0.5 ? -1 : 1
        token.style.opacity = '1'
        const frame = (now: number) => {
          const t = Math.min(1, (now - t0) / duration)
          const g = at(t)
          const p = path.getPointAtLength(g.pos)
          // on the move it turns; at a station it slows and breathes a little
          const rate = g.moving ? 1 : 0.15
          const breath = g.moving ? 0 : Math.sin(((now - t0) / 1000) * Math.PI * 0.5) * 0.05
          tokenAt = { x: p.x, y: p.y }
          token.style.transform = `translate(${p.x}px, ${p.y}px) scale(${1 + breath})`
          ang += rate * 0.7 * dir
          spin.style.transform = `rotateX(${ang}deg) rotateY(${ang * 1.5}deg)`
          stations.forEach((s, i) => {
            if (g.pos >= marks[i] + 6) s.classList.add('passed')
          })
          if (t < 1) requestAnimationFrame(frame)
          else {
            flow.classList.add('done')
            running = false
          }
        }
        requestAnimationFrame(frame)
      }
      // An easter egg: once a run is over, tapping the first beat spawns a new token — another
      // colour from the hero's set, another size, turning the other way — and runs it from the start.
      const first = stations[0].parentElement!
      first.addEventListener('click', () => {
        if (running || !ran) return
        token.classList.remove(...COLORS)
        token.classList.add(COLORS[Math.floor(Math.random() * COLORS.length)])
        token.style.setProperty('--s', `${12 + Math.round(Math.random() * 8)}px`)
        spin.style.transform = ''
        run()
      })
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            run()
            io.disconnect()
          }
        },
        { threshold: 0.35 },
      )
      io.observe(flow)
      addEventListener('resize', () => {
        if (!ran) layout()
      })
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) flowing = false
        else if (ran) startDust()
      })
    }
  }
</script>

<style>
  .dta-workflow-frame {
    container-type: inline-size;
    color: var(--fg-default);
    font-family: var(--font-sans);
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .intro {
    margin-bottom: var(--space-10);
  }

  /* Phone first: the beats stacked down a line on the left. */
  .flow {
    position: relative;
    padding-bottom: 100px;
  }
  .line {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .line path[data-path] {
    fill: none;
    stroke: var(--rail);
    stroke-width: 1;
    stroke-dasharray: 1 7;
    stroke-linecap: round;
    opacity: 0.7;
  }
  .line .end {
    fill: var(--bg-canvas);
    stroke: var(--action-bg);
    stroke-width: 2;
    transition: fill var(--motion-duration-slow) var(--motion-ease-exit);
  }
  .line .halo {
    fill: var(--action-bg);
    opacity: 0;
    transition: opacity var(--motion-duration-slow) var(--motion-ease-exit);
  }
  .line .tick {
    fill: none;
    stroke: var(--terminal-bg);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0;
    transition: opacity var(--motion-duration-base) var(--motion-ease-enter);
  }
  .done .line .end {
    fill: var(--action-bg);
  }
  .done .line .halo {
    opacity: 0.22;
  }
  .done .line .tick {
    opacity: 1;
  }
  .beats {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
    margin: 0;
    padding: 0 0 0 var(--space-10);
    list-style: none;
  }
  .beat {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .station {
    position: absolute;
    left: calc(var(--space-10) * -1);
    top: 6px;
    width: 16px;
    height: 16px;
    box-sizing: border-box;
    border-radius: var(--radius-full);
    border: var(--stroke-ink) solid var(--border-strong);
    background: var(--bg-canvas);
    transition: background var(--motion-duration-slow) var(--motion-ease-exit);
  }
  .station.passed {
    background: var(--border-strong);
  }
  .where,
  .end-label {
    font-family: var(--font-mono);
    font-size: calc(var(--type-meta-size) * 1px);
    line-height: var(--type-meta-line-height);
    letter-spacing: var(--type-meta-letter-spacing);
    text-transform: uppercase;
    color: var(--fg-muted);
    white-space: nowrap;
  }
  .beat h3 {
    margin: 0;
    font-size: calc(var(--type-title-size) * 1px);
    font-weight: var(--type-title-weight);
    line-height: var(--type-title-line-height);
    letter-spacing: -0.01em;
  }
  .beat p {
    margin: 0;
    max-width: 40ch;
    font-size: calc(var(--type-body-size) * 1px);
    line-height: var(--type-body-line-height);
    color: var(--fg-muted);
  }
  .end-label {
    position: absolute;
    left: 0;
    top: 0;
  }
  .end-label {
    color: var(--action-text);
  }

  /* The token: the hero's cube, and its dust. */
  .cube {
    --s: 16px;
    position: absolute;
    left: 0;
    top: 0;
    width: var(--s);
    height: var(--s);
    margin: calc(var(--s) * -0.5) 0 0 calc(var(--s) * -0.5);
    opacity: 0;
    transform-style: preserve-3d;
    pointer-events: none;
  }
  .cube.orange {
    --f: var(--well-object-orange);
    --f2: var(--well-object-orange-light);
    --f3: var(--well-object-orange-dark);
  }
  .cube.blue {
    --f: var(--well-object-blue);
    --f2: var(--well-object-blue-light);
    --f3: var(--well-object-blue-dark);
  }
  .cube.ink {
    --f: var(--well-object-ink);
    --f2: var(--well-object-ink-light);
    --f3: var(--well-object-ink-dark);
  }
  .spin {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
  }
  .cube i {
    position: absolute;
    inset: 0;
    background: var(--f);
    border: var(--stroke-hairline) solid color-mix(in srgb, var(--well-throat) 12%, transparent);
    transition: background var(--motion-duration-slow) var(--motion-ease-exit);
  }
  .cube i:nth-child(1) {
    transform: translateZ(calc(var(--s) * 0.5));
  }
  .cube i:nth-child(2) {
    transform: rotateY(180deg) translateZ(calc(var(--s) * 0.5));
    background: var(--f3);
  }
  .cube i:nth-child(3) {
    transform: rotateY(90deg) translateZ(calc(var(--s) * 0.5));
    background: var(--f3);
  }
  .cube i:nth-child(4) {
    transform: rotateY(-90deg) translateZ(calc(var(--s) * 0.5));
    background: var(--f2);
  }
  .cube i:nth-child(5) {
    transform: rotateX(90deg) translateZ(calc(var(--s) * 0.5));
    background: var(--f2);
  }
  .cube i:nth-child(6) {
    transform: rotateX(-90deg) translateZ(calc(var(--s) * 0.5));
    background: var(--f3);
  }
  .dust {
    position: absolute;
    left: 0;
    top: 0;
    border-radius: var(--radius-full);
    background: var(--well-dust);
    opacity: 0;
    pointer-events: none;
  }
  .dust.d {
    width: 3px;
    height: 3px;
    margin: -1.5px 0 0 -1.5px;
    background: var(--well-object-orange);
  }
  .dust.d2 {
    width: 2px;
    height: 2px;
    margin: -1px 0 0 -1px;
  }
  .dust.s,
  .dust.s2 {
    --f: var(--well-object-ink);
    --f2: var(--well-object-ink-light);
    --f3: var(--well-object-ink-dark);
    background: radial-gradient(
      circle at 32% 30%,
      color-mix(in srgb, var(--well-highlight) 60%, var(--f2)) 0,
      var(--f) 42%,
      var(--f3) 100%
    );
  }
  .dust.s {
    width: 7px;
    height: 7px;
    margin: -3.5px 0 0 -3.5px;
  }
  .dust.s2 {
    width: 5px;
    height: 5px;
    margin: -2.5px 0 0 -2.5px;
  }

  /* Under reduced motion the finished picture is shown at once, without transitions. */
  .still .line .end,
  .still .line .halo,
  .still .line .tick,
  .still .station,
  .still .cube i {
    transition: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .line .end,
    .line .halo,
    .line .tick,
    .station,
    .cube i {
      transition: none;
    }
  }

  /* Three columns on one horizontal line from 960px of container. */
  @container (min-width: 960px) {
    .intro {
      margin-bottom: var(--space-16);
    }
    .flow {
      padding: var(--space-10) 180px 0 0;
    }
    .beats {
      flex-direction: row;
      gap: var(--space-16);
      padding: 0;
    }
    .beat {
      flex: 1;
    }
    .station {
      left: 0;
      top: calc(var(--space-10) * -1);
    }
  }
</style>
