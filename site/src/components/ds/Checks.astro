---
/**
 * The checks of a pull request and the approve action: each check a flat row on bg-surface with
 * a hairline, its status as a dot and a word; the approve action in the action text colour so
 * its label reads at 7:1 in both themes.
 */
export interface Check {
  name: string
  status: 'passed' | 'pending' | 'changes'
  detail?: string
}

interface Props {
  checks: Check[]
  approve?: string
}
const { checks, approve } = Astro.props
const words = { passed: 'passed', pending: 'pending', changes: 'changes to review' }
---

<div class="dta-checks">
  <ul class="list">
    {
      checks.map((check) => (
        <li class:list={['check', check.status]}>
          <span class="dot" aria-hidden="true" />
          <span class="name">{check.name}</span>
          <span class="status">
            {words[check.status]}
            {check.detail && <span class="detail"> · {check.detail}</span>}
          </span>
        </li>
      ))
    }
  </ul>
  {approve && <span class="approve">{approve}</span>}
</div>

<style>
  .dta-checks {
    display: grid;
    gap: var(--space-4);
    width: min(100%, 480px);
    justify-items: start;
  }
  .list {
    display: grid;
    gap: 10px;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .check {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 10px;
    align-items: center;
    padding: var(--space-4);
    border: var(--stroke-hairline) solid var(--border-default);
    border-radius: 12px;
    background: var(--bg-surface);
    color: var(--fg-default);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.3;
  }
  .dot {
    width: 10px;
    height: 10px;
    border-radius: var(--radius-full);
    background: var(--fg-subtle);
  }
  .passed .dot {
    background: var(--success-fg);
  }
  .changes .dot {
    background: var(--signal-bg);
  }
  .name {
    white-space: nowrap;
  }
  .status {
    color: var(--fg-muted);
    font-size: calc(var(--type-meta-size) * 1px);
    white-space: nowrap;
  }
  .passed .status {
    color: var(--success-fg);
  }
  .changes .status {
    color: var(--signal-text);
  }
  @media (max-width: 559px) {
    .check {
      grid-template-columns: auto minmax(0, 1fr);
    }
    .status {
      grid-column: 2;
      white-space: normal;
    }
  }
  .approve {
    display: inline-block;
    padding: 11px var(--space-4);
    border-radius: 11px;
    background: var(--action-text);
    color: var(--action-fg);
    font-family: var(--font-sans);
    font-size: calc(var(--type-body-sm-size) * 1px);
    font-weight: 500;
    line-height: 1.2;
  }
</style>
