---
/**
 * The pipeline as numbered stations on a dashed rail, with a signal packet travelling along it.
 * Below 760px: two columns, no rail, no packet.
 */
interface Station {
  label: string
  state: 'done' | 'active' | 'next' | 'review'
  actor?: string
}
interface Props {
  stations: Station[]
}
const { stations } = Astro.props
const stateText = { done: 'done', active: 'in progress', next: 'next', review: 'in review' }
---

<div class="dta-rail" style={`--stations: ${stations.length}`}>
  <div class="line" aria-hidden="true"></div>
  <div class="packet" aria-hidden="true"><span></span></div>
  <ol>
    {
      stations.map((station, index) => (
        <li>
          <span class:list={['station', station.state]}>{String(index + 1).padStart(2, '0')}</span>
          <p>
            {station.label}
            <span class="visually-hidden">, {stateText[station.state]}</span>
          </p>
          {station.actor && <small>{station.actor}</small>}
        </li>
      ))
    }
  </ol>
</div>

<style>
  .dta-rail {
    position: relative;
    padding: var(--space-6) var(--space-8);
    color: var(--fg-default);
    font-family: var(--font-sans);
  }
  .line {
    position: absolute;
    left: 12%;
    right: 12%;
    top: var(--space-12);
    border-top: var(--stroke-ink) dashed var(--rail);
  }
  .packet {
    position: absolute;
    left: 12%;
    right: 12%;
    top: 41px;
    height: 14px;
  }
  .packet span {
    position: absolute;
    width: 14px;
    height: 14px;
    margin-left: -7px;
    border-radius: 4px;
    background: var(--signal-bg);
    animation: travel 7.2s linear infinite;
  }
  @keyframes travel {
    from {
      left: 0;
    }
    to {
      left: 100%;
    }
  }
  ol {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--stations), minmax(0, 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
    text-align: center;
  }
  .station {
    display: inline-flex;
    box-sizing: border-box;
    width: 50px;
    height: 50px;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    font-family: var(--font-mono);
    font-size: calc(var(--type-meta-size) * 1px);
    font-weight: 500;
  }
  .done {
    background: var(--success-fg);
    color: var(--action-fg);
  }
  .active {
    background: var(--action-bg);
    color: var(--action-fg);
    box-shadow: 0 0 0 5px var(--action-subtle);
  }
  .next {
    border: var(--stroke-ink) solid var(--border-strong);
    background: var(--bg-surface);
  }
  .review {
    border: var(--stroke-ink) solid var(--signal-bg);
    background: var(--signal-subtle);
    color: var(--signal-text);
  }
  p {
    margin: var(--space-2) 0 0;
    font-size: calc(var(--type-body-sm-size) * 1px);
    font-weight: var(--type-label-weight);
  }
  small {
    display: block;
    font-size: calc(var(--type-meta-size) * 1px);
    color: var(--fg-subtle);
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  @media (max-width: 760px) {
    .line,
    .packet {
      display: none;
    }
    ol {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .packet span {
      animation: none;
    }
  }
</style>
