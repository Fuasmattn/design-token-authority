---
/**
 * The commands at a glance (TICKET-168): a grid of command chips, one muted line under each; no
 * rules, no glyphs, no boxes. Three columns on desktop, two on tablets, a list on phones. Says
 * what `dta` is made of without telling a story.
 */
import CommandButton from './CommandButton.astro'

export interface CommandCell {
  /** The command as typed: `dta lint`. */
  command: string
  /** One short line: what it does. */
  text: string
}

interface Props {
  commands: CommandCell[]
}
const { commands } = Astro.props
---

<div class="dta-commands-frame">
  <ul class="dta-commands">
    {
      commands.map((cell) => (
        <li class="cell">
          <CommandButton command={cell.command} />
          <p>{cell.text}</p>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .dta-commands-frame {
    container-type: inline-size;
  }
  .dta-commands {
    display: grid;
    gap: var(--space-8) var(--space-10);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cell {
    display: grid;
    /* Start-packed: a stretched cell (a neighbour's line wraps) must not grow the chip. */
    align-content: start;
    justify-items: start;
    gap: var(--space-3);
  }
  p {
    margin: 0;
    font-family: var(--font-sans);
    font-size: calc(var(--type-label-size) * 1px);
    line-height: 1.55;
    color: var(--fg-muted);
  }
  @container (min-width: 560px) {
    .dta-commands {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @container (min-width: 1000px) {
    .dta-commands {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-10) var(--space-12);
    }
  }
</style>
