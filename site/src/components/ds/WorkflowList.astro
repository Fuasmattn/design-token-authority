---
/**
 * The workflow as a numbered list grouped by where each step happens (TICKET-153, design system
 * "WorkflowList", principle 6 "One rhythm per list"): the change is made on one side (Figma, a
 * token file, an agent), `dta pull` carries it across on a dashed connector, and inside the pull
 * request, one card, every step has the same row: number, label, the command on the label's
 * baseline, one line below. A return line under the card says where a fix goes; no arrow back.
 * The accent is blueprint (`action`), not the redline: nothing here has changed yet.
 *
 * One column on a phone. From 960px of container two columns: the change and the crossing on
 * the left, the card on the right. No motion.
 */
import CommandButton from './CommandButton.astro'

export interface WorkflowStep {
  /** One word. */
  label: string
  /** One short line. */
  text: string
  command?: string
}

interface Props {
  /** Read by screen readers as the section's heading; not shown. */
  title: string
  /** The design side: where the change is made. */
  change: WorkflowStep & { side: string }
  /** The crossing into the repository: its command and a short line. */
  crossing: { command: string; text: string }
  /** Eyebrow of the card: "in the pull request". */
  pullRequest: string
  steps: WorkflowStep[]
  /** Where a fix goes (no arrow back to the start). */
  back?: { text: string; command?: string; detail?: string }
  /** The right slot of a step without a command. */
  person?: string
  id?: string
  idPrefix?: string
}
const {
  title,
  change,
  crossing,
  pullRequest,
  steps,
  back,
  person = 'a person',
  id,
  idPrefix = 'workflow',
} = Astro.props
const headingId = `${idPrefix}-title`
---

<section class="dta-workflow-frame" id={id} aria-labelledby={headingId}>
  <h2 class="visually-hidden" id={headingId}>{title}</h2>
  <ol class="dta-workflow">
    <li class="side">
      <div class="row">
        <span class="num start" aria-hidden="true">1</span>
        <div class="body">
          <div class="line">
            <strong class="label">{change.label}</strong>
            <span class="where">{change.side}</span>
          </div>
          <p class="text">{change.text}</p>
        </div>
      </div>
      <div class="crossing">
        <span class="rail" aria-hidden="true"></span>
        <div class="crossing-body">
          <CommandButton command={crossing.command} />
          <span class="where">{crossing.text}</span>
        </div>
      </div>
    </li>

    <li class="pr">
      <span class="eyebrow">{pullRequest}</span>
      <ol class="steps">
        {
          steps.map((step, index) => (
            <li class="row">
              <span class="num" aria-hidden="true">
                {index + 2}
              </span>
              <div class="body">
                <div class="line">
                  <strong class="label">{step.label}</strong>
                  {step.command ? (
                    <code class="command">
                      <span class="prompt" aria-hidden="true">
                        $
                      </span>
                      {step.command}
                    </code>
                  ) : (
                    <span class="person">{person}</span>
                  )}
                </div>
                <p class="text">{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
      {
        back && (
          <p class="back">
            <span>{back.text}</span>
            {back.command && (
              <span class="back-command">
                <CommandButton command={back.command} />
                {back.detail && <span class="detail">{back.detail}</span>}
              </span>
            )}
          </p>
        )
      }
    </li>
  </ol>
</section>

<style>
  .dta-workflow-frame {
    container-type: inline-size;
    color: var(--fg-default);
    font-family: var(--font-sans);
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .dta-workflow,
  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* One rhythm: number column, label with the command on its baseline, one line below. */
  .row {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
  }
  .num {
    flex-shrink: 0;
    width: 28px;
    padding-top: var(--space-1);
    font-family: var(--font-mono);
    font-size: calc(var(--type-meta-size) * 1px);
    line-height: var(--type-meta-line-height);
    color: var(--fg-muted);
  }
  .num.start {
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    height: 28px;
    padding: 0;
    border: var(--stroke-ink) solid var(--border-strong);
    border-radius: var(--radius-sm);
    color: var(--fg-default);
  }
  .body {
    flex-grow: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .line {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
  }
  .label {
    min-width: 0;
    font-size: calc(var(--type-title-size) * 1px);
    font-weight: var(--type-title-weight);
    line-height: var(--type-title-line-height);
    letter-spacing: -0.01em;
  }
  .command,
  .where,
  .person {
    flex-shrink: 0;
    white-space: nowrap;
    font-family: var(--font-mono);
  }
  .command {
    font-size: calc(var(--type-code-size) * 1px);
    line-height: var(--type-code-line-height);
    color: var(--fg-default);
  }
  .prompt {
    margin-right: 0.5em;
    color: var(--action-bg);
  }
  .where,
  .person {
    font-size: calc(var(--type-meta-size) * 1px);
    line-height: var(--type-meta-line-height);
    letter-spacing: var(--type-meta-letter-spacing);
    text-transform: uppercase;
    color: var(--fg-muted);
  }
  .person {
    color: var(--action-text);
  }
  .text {
    margin: 0;
    font-size: calc(var(--type-body-sm-size) * 1px);
    line-height: var(--type-body-sm-line-height);
    color: var(--fg-muted);
  }

  /* The crossing into the repository: a dashed rail in the number column, the command beside. */
  .crossing {
    display: flex;
    gap: var(--space-4);
    min-height: 88px;
    margin: var(--space-2) 0;
  }
  .rail {
    display: flex;
    justify-content: center;
    flex-shrink: 0;
    width: 28px;
  }
  .rail::before {
    content: '';
    display: block;
    width: 0;
    border-left: var(--stroke-ink) dashed var(--rail);
  }
  .crossing-body {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  /* The pull request: one card, hairlines between the rows. */
  .pr {
    box-sizing: border-box;
    padding: var(--space-4) var(--space-4) var(--space-2);
    border: var(--stroke-hairline) solid var(--border-default);
    border-radius: var(--radius-lg);
    background: var(--bg-surface);
  }
  .eyebrow {
    display: block;
    padding-bottom: var(--space-4);
    font-family: var(--font-mono);
    font-size: calc(var(--type-meta-size) * 1px);
    line-height: var(--type-meta-line-height);
    letter-spacing: var(--type-meta-letter-spacing);
    text-transform: uppercase;
    color: var(--action-text);
  }
  .steps .row {
    padding: var(--space-4) 0;
    border-top: var(--stroke-hairline) solid var(--border-default);
  }
  .back {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    align-items: center;
    margin: 0;
    padding: var(--space-4) 0 var(--space-2);
    border-top: var(--stroke-hairline) solid var(--border-default);
    font-size: calc(var(--type-body-sm-size) * 1px);
    line-height: var(--type-body-sm-line-height);
    color: var(--fg-muted);
  }
  .back-command {
    display: inline-flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
  }
  .detail {
    font-family: var(--font-mono);
    font-size: calc(var(--type-meta-size) * 1px);
  }

  /* Two columns: the change and the crossing, then the card. */
  @container (min-width: 960px) {
    .dta-workflow {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      gap: var(--space-8);
      align-items: start;
    }
    .pr {
      max-width: var(--layout-measure);
      padding: var(--space-6) var(--space-6) var(--space-3);
    }
    .crossing {
      margin-top: var(--space-4);
    }
  }
</style>
