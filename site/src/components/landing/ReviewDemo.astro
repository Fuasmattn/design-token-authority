---
/**
 * "See it": one design change, three kinds of findings (mockup J · Drafting Table). Server
 * renders every tab and finding; a small script switches them (ARIA tabs with arrow keys,
 * findings as pressed buttons) and drives the drag-to-compare slider. Example data.
 */
import { REVIEW_TABS, type Finding, type Severity } from '../../landing/content'

const severityTone: Record<Severity, 'signal' | 'muted' | 'ok'> = {
  error: 'signal',
  breaking: 'signal',
  'needs review': 'signal',
  warning: 'muted',
  expected: 'ok',
}
const first = REVIEW_TABS[0]
const isTiles = (f: Finding): f is Extract<Finding, { kind: 'tiles' }> => f.kind === 'tiles'
---

<div class="demo" data-review-demo>
  <div class="tabs" role="tablist" aria-label="Finding type">
    {
      REVIEW_TABS.map((tab) => (
        <button
          type="button"
          role="tab"
          id={`review-tab-${tab.id}`}
          aria-controls={`review-panel-${tab.id}`}
          aria-selected={tab === first ? 'true' : 'false'}
          tabindex={tab === first ? 0 : -1}
          data-tab={tab.id}
        >
          {tab.label}
          <span class="count">{tab.findings.length}</span>
        </button>
      ))
    }
  </div>

  {
    REVIEW_TABS.map((tab) => (
      <div
        class="panel"
        role="tabpanel"
        id={`review-panel-${tab.id}`}
        aria-labelledby={`review-tab-${tab.id}`}
        hidden={tab !== first}
        data-panel={tab.id}
      >
        {tab.coming && (
          <p class="coming-note">
            <span class="coming">coming</span>
            {tab.coming}
          </p>
        )}
        <div class="rep">
          <div class="findings" role="group" aria-label={`${tab.label} findings`}>
            {tab.findings.map((f, i) => (
              <button
                type="button"
                class="finding"
                aria-pressed={i === (tab.id === 'structure' ? 1 : 0) ? 'true' : 'false'}
                data-finding={f.id}
              >
                <span class={`sev ${severityTone[f.severity]}`}>
                  <span class="dot" aria-hidden="true" />
                  {f.severity}
                  {f.coming && <span class="coming">coming</span>}
                </span>
                <span class="f-title">{f.title}</span>
                <span class="f-sub">{f.sub}</span>
              </button>
            ))}
          </div>

          <div class="details">
            {tab.findings.map((f, i) => (
              <article
                class="detail"
                data-detail={f.id}
                hidden={i !== (tab.id === 'structure' ? 1 : 0)}
                aria-label={f.title}
              >
                <div>
                  <p class={`sev ${severityTone[f.severity]}`}>
                    {f.severity} · {f.rule}
                    {f.coming && <span class="coming">coming</span>}
                  </p>
                  <h3>{f.title}</h3>
                  <p class="text">{f.text}</p>
                </div>

                <div class="sheet">
                  {f.kind === 'name' && (
                    <>
                      <p class="name-parts">
                        {f.parts.map((p) => (
                          <span class:list={['part', { bad: p.bad }]}>{p.text}</span>
                        ))}
                      </p>
                      <p class="mono small">
                        rule <span class="ink">{f.ruleText}</span>
                      </p>
                      <p class="mono">
                        suggested <span class="fix">{f.fix}</span>
                      </p>
                    </>
                  )}
                  {f.kind === 'chain' && (
                    <>
                      <p class="mono label found">FOUND</p>
                      <p class="chain">
                        <span class="node strong">{f.from}</span>
                        <span class="gap">
                          <span class="gap-tag">{f.gap}</span>
                        </span>
                        <span class="node">{f.to}</span>
                      </p>
                      <p class="mono label expected">EXPECTED</p>
                      <p class="chain">
                        <span class="node">{f.from}</span>
                        <span class="arrow">→</span>
                        <span class="node semantic">{f.via}</span>
                        <span class="arrow">→</span>
                        <span class="node">{f.to}</span>
                      </p>
                    </>
                  )}
                  {f.kind === 'rename' && (
                    <>
                      <p class="rename">
                        <span class="old">{f.old}</span>
                        <span class="arrow signal-ink">→</span>
                        <span class="next">{f.next}</span>
                      </p>
                      <p class="uses">
                        {f.uses.map((u) => (
                          <span class="use">{u}</span>
                        ))}
                      </p>
                      <p class="mono small">{f.caption}</p>
                    </>
                  )}
                  {isTiles(f) && (
                    <>
                      <div class="tiles" aria-hidden="true">
                        {f.tiles.map((t) => (
                          <span class:list={['tile', { flagged: t.fill === 'hatch' }]}>
                            <span class="mini" style={`border-radius: ${t.radius}px`}>
                              <span class:list={['bar', t.fill]} />
                            </span>
                          </span>
                        ))}
                      </div>
                      <p class="mono small">{f.caption}</p>
                    </>
                  )}
                </div>

                <div class="actions">
                  <button type="button" class="act primary" data-action={f.actions[0]}>
                    {f.actions[0]}
                  </button>
                  <button type="button" class="act outline" data-action={f.actions[1]}>
                    {f.actions[1]}
                  </button>
                  <span class="recorded" aria-live="polite" hidden />
                </div>
              </article>
            ))}
          </div>
        </div>

        {tab.id === 'diff' && (
          <div class="compare" data-compare>
            <div class="compare-head">
              <span class="mono small subtle">Card / pricing · desktop</span>
              <button type="button" class="overlay-toggle" aria-pressed="false" data-overlay>
                diff overlay
              </button>
            </div>
            <div class="stage" style="--split: 50%">
              <div class="side candidate">
                <div class="card candidate-card">
                  <p class="card-title">Monthly plan</p>
                  <p class="card-text">[Plan description]</p>
                  <span class="card-cta">Continue</span>
                  <span class="hot hot-cta" aria-hidden="true" />
                  <span class="hot hot-tl" aria-hidden="true" />
                  <span class="hot hot-br" aria-hidden="true" />
                </div>
              </div>
              <div class="side baseline" aria-hidden="true">
                <div class="card baseline-card">
                  <p class="card-title">Monthly plan</p>
                  <p class="card-text">[Plan description]</p>
                  <span class="card-cta">Continue</span>
                </div>
              </div>
              <span class="knob" aria-hidden="true">↔</span>
              <span class="tag tag-base">baseline · main</span>
              <span class="tag tag-head">candidate · PR #142</span>
            </div>
            <label class="range-label" for="review-split">
              <span>drag to compare</span>
              <span data-split-value>50%</span>
            </label>
            <input id="review-split" type="range" min="0" max="100" step="1" value="50" />
          </div>
        )}
      </div>
    ))
  }
</div>

<script>
  for (const demo of document.querySelectorAll<HTMLElement>('[data-review-demo]')) {
    const tabs = [...demo.querySelectorAll<HTMLButtonElement>('[role="tab"]')]
    const select = (tab: HTMLButtonElement, focus = false) => {
      for (const t of tabs) {
        const on = t === tab
        t.setAttribute('aria-selected', String(on))
        t.tabIndex = on ? 0 : -1
        const panel = demo.querySelector<HTMLElement>(`[data-panel="${t.dataset.tab}"]`)
        if (panel) panel.hidden = !on
      }
      if (focus) tab.focus()
    }
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab))
      tab.addEventListener('keydown', (event) => {
        const next =
          event.key === 'ArrowRight'
            ? tabs[(i + 1) % tabs.length]
            : event.key === 'ArrowLeft'
              ? tabs[(i - 1 + tabs.length) % tabs.length]
              : event.key === 'Home'
                ? tabs[0]
                : event.key === 'End'
                  ? tabs[tabs.length - 1]
                  : null
        if (next) {
          event.preventDefault()
          select(next, true)
        }
      })
    })

    for (const panel of demo.querySelectorAll<HTMLElement>('[data-panel]')) {
      const findings = [...panel.querySelectorAll<HTMLButtonElement>('[data-finding]')]
      for (const finding of findings) {
        finding.addEventListener('click', () => {
          for (const f of findings) {
            const on = f === finding
            f.setAttribute('aria-pressed', String(on))
            const detail = panel.querySelector<HTMLElement>(`[data-detail="${f.dataset.finding}"]`)
            if (detail) detail.hidden = !on
          }
        })
      }
      for (const button of panel.querySelectorAll<HTMLButtonElement>('[data-action]')) {
        button.addEventListener('click', () => {
          const recorded = button.parentElement?.querySelector<HTMLElement>('.recorded')
          if (!recorded) return
          recorded.hidden = false
          recorded.textContent = `Recorded: ${button.dataset.action}`
        })
      }
    }

    for (const compare of demo.querySelectorAll<HTMLElement>('[data-compare]')) {
      const stage = compare.querySelector<HTMLElement>('.stage')
      const range = compare.querySelector<HTMLInputElement>('input[type="range"]')
      const value = compare.querySelector<HTMLElement>('[data-split-value]')
      range?.addEventListener('input', () => {
        stage?.style.setProperty('--split', `${range.value}%`)
        if (value) value.textContent = `${range.value}%`
      })
      const overlay = compare.querySelector<HTMLButtonElement>('[data-overlay]')
      overlay?.addEventListener('click', () => {
        const on = overlay.getAttribute('aria-pressed') !== 'true'
        overlay.setAttribute('aria-pressed', String(on))
        compare.classList.toggle('show-overlay', on)
      })
    }
  }
</script>

<style>
  .demo {
    display: grid;
    gap: 20px;
  }
  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    width: fit-content;
    max-width: 100%;
    padding: 4px;
    border-radius: 12px;
    background: var(--bg-subtle);
  }
  [role='tab'] {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 14px;
    border: 0;
    border-radius: 9px;
    background: transparent;
    color: var(--fg-muted);
    font: 600 14px var(--font-sans);
    cursor: pointer;
  }
  [role='tab'][aria-selected='true'] {
    background: var(--bg-surface);
    color: var(--fg-default);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.12);
  }
  .count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 20px;
    padding: 0 5px;
    border-radius: 10px;
    background: var(--bg-surface);
    color: var(--fg-muted);
    font: 400 11px var(--font-mono);
  }
  [aria-selected='true'] .count {
    background: var(--signal-subtle);
    color: var(--signal-text);
  }
  .coming {
    display: inline-flex;
    align-items: center;
    height: 20px;
    margin-left: 6px;
    padding: 0 6px;
    border-radius: 4px;
    background: var(--action-subtle);
    color: var(--action-text);
    font: 400 10.5px var(--font-mono);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .coming-note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 0 0 16px;
    color: var(--fg-muted);
    font-size: 15px;
  }
  .coming-note .coming {
    margin-left: 0;
  }
  .rep {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    align-items: stretch;
  }
  .findings {
    flex: 1 1 340px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .finding {
    padding: 16px 18px;
    border: 0;
    border-radius: 14px;
    background: var(--bg-surface);
    color: var(--fg-default);
    box-shadow: inset 0 0 0 1px var(--border-default);
    font-family: var(--font-sans);
    text-align: left;
    cursor: pointer;
  }
  .finding[aria-pressed='true'] {
    box-shadow:
      inset 0 0 0 2px var(--action-bg),
      0 0 0 4px var(--action-subtle);
  }
  .sev {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 0;
    font: 400 11px var(--font-mono);
  }
  .sev.signal {
    color: var(--signal-text);
  }
  .sev.muted {
    color: var(--fg-subtle);
  }
  .sev.ok {
    color: var(--success-fg);
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
  }
  .f-title {
    display: block;
    margin-top: 6px;
    font-weight: 700;
    font-size: 16px;
  }
  .f-sub {
    display: block;
    margin-top: 4px;
    font-size: 13.5px;
    color: var(--fg-muted);
  }
  .details {
    flex: 1.5 1 480px;
    min-width: 0;
    display: flex;
  }
  .detail {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 26px;
    border-radius: 18px;
    background: var(--bg-surface);
    box-shadow: inset 0 0 0 1px var(--border-default);
  }
  .detail[hidden] {
    display: none;
  }
  .detail h3 {
    margin: 8px 0 0;
    font-size: 22px;
    line-height: 1.2;
  }
  .text {
    margin: 8px 0 0;
    font-size: 15.5px;
    line-height: 1.55;
    color: var(--fg-muted);
  }
  /* The "sheet": a piece of the reviewed UI, always on paper (like a screenshot). */
  .sheet {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
    min-height: 150px;
    padding: 22px;
    border-radius: 12px;
    background: var(--paper-50);
    box-shadow: inset 0 0 0 1px var(--border-default);
    color: var(--ink-900);
  }
  .sheet p {
    margin: 0;
  }
  .mono {
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .small {
    font-size: 11px;
    color: var(--ink-600);
  }
  .subtle {
    color: var(--fg-subtle);
  }
  .ink {
    color: var(--ink-900);
  }
  .label {
    font-size: 10.5px;
  }
  .found {
    color: var(--redline-800);
  }
  .expected {
    color: var(--sage-600);
  }
  .name-parts {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px;
    font: 400 18px var(--font-mono);
  }
  .part {
    padding: 2px 4px;
    border-radius: 4px;
    white-space: pre;
  }
  .part.bad {
    background: var(--redline-100);
    color: var(--redline-800);
  }
  .fix {
    padding: 2px 6px;
    border-radius: 4px;
    background: var(--sage-100);
    color: var(--sage-600);
  }
  .chain {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font: 400 12.5px var(--font-mono);
  }
  .node {
    padding: 6px 10px;
    border-radius: 6px;
    background: var(--paper-0);
    box-shadow: inset 0 0 0 1px var(--paper-300);
  }
  .node.strong {
    box-shadow: inset 0 0 0 1.5px var(--ink-900);
  }
  .node.semantic {
    background: var(--blueprint-100);
    color: var(--blueprint-800);
    box-shadow: none;
  }
  .gap {
    position: relative;
    display: inline-block;
    width: 120px;
    margin-top: 22px;
    border-top: 1.5px dashed var(--redline-500);
  }
  .gap-tag {
    position: absolute;
    left: 50%;
    top: -22px;
    transform: translateX(-50%);
    padding: 1px 6px;
    border-radius: 4px;
    background: var(--redline-500);
    color: var(--graphite-950);
    font-size: 10px;
    white-space: nowrap;
  }
  .arrow {
    color: var(--ink-600);
  }
  .signal-ink {
    color: var(--redline-500);
  }
  .rename {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    font: 400 15px var(--font-mono);
  }
  .old {
    color: var(--ink-600);
    text-decoration: line-through;
    text-decoration-color: var(--redline-500);
    text-decoration-thickness: 2px;
  }
  .next {
    font-weight: 500;
  }
  .uses {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .use {
    display: inline-flex;
    align-items: center;
    height: 26px;
    padding: 0 8px;
    border-radius: 6px;
    background: var(--paper-0);
    box-shadow: inset 0 0 0 1px var(--paper-300);
    font: 400 11px var(--font-mono);
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 6px;
  }
  .tile {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 54px;
    border-radius: 6px;
    background: var(--paper-0);
    box-shadow: inset 0 0 0 1px var(--paper-300);
  }
  .tile.flagged {
    box-shadow: inset 0 0 0 2px var(--redline-500);
  }
  .mini {
    display: flex;
    align-items: flex-end;
    box-sizing: border-box;
    width: 64%;
    height: 30px;
    padding: 4px;
    background: var(--paper-0);
    box-shadow: 0 0 0 1px var(--paper-300);
  }
  .bar {
    display: block;
    width: 100%;
    height: 8px;
    border-radius: 2px;
  }
  .bar.blue-700 {
    background: var(--blueprint-700);
  }
  .bar.blue-600 {
    background: var(--blueprint-600);
  }
  .bar.hatch {
    background: repeating-linear-gradient(
      45deg,
      var(--redline-500) 0 3px,
      var(--redline-100) 3px 6px
    );
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }
  .act {
    min-height: 44px;
    padding: 0 16px;
    border-radius: var(--radius-md);
    font: 600 14px var(--font-sans);
    cursor: pointer;
  }
  .act.primary {
    border: 0;
    background: var(--action-bg);
    color: var(--action-fg);
  }
  .act.outline {
    border: var(--stroke-ink) solid var(--border-strong);
    background: transparent;
    color: var(--fg-default);
  }
  .recorded {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 30px;
    padding: 0 10px;
    border-radius: 6px;
    background: var(--success-subtle);
    color: var(--success-fg);
    font: 400 11.5px var(--font-mono);
  }
  .recorded[hidden] {
    display: none;
  }
  .compare {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 20px;
    padding: 20px;
    border-radius: 18px;
    background: var(--bg-surface);
  }
  .compare-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
  }
  .overlay-toggle {
    min-height: 44px;
    padding: 0 12px;
    border: var(--stroke-ink) solid var(--border-strong);
    border-radius: 6px;
    background: transparent;
    color: var(--fg-default);
    font: 400 12px var(--font-mono);
    cursor: pointer;
  }
  .overlay-toggle::after {
    content: ' · off';
  }
  .overlay-toggle[aria-pressed='true'] {
    border-color: var(--signal-bg);
    background: var(--signal-bg);
    color: var(--signal-fg);
  }
  .overlay-toggle[aria-pressed='true']::after {
    content: ' · on';
  }
  .stage {
    position: relative;
    height: 320px;
    overflow: hidden;
    border-radius: 12px;
    background-color: var(--paper-50);
    background-image:
      linear-gradient(var(--paper-150) 1px, transparent 1px),
      linear-gradient(90deg, var(--paper-150) 1px, transparent 1px);
    background-size: 16px 16px;
  }
  .side {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  /* Baseline on the left of the divider, candidate on the right. */
  .baseline {
    clip-path: inset(0 calc(100% - var(--split)) 0 0);
    background-color: var(--paper-50);
    background-image:
      linear-gradient(var(--paper-150) 1px, transparent 1px),
      linear-gradient(90deg, var(--paper-150) 1px, transparent 1px);
    background-size: 16px 16px;
  }
  .card {
    position: relative;
    width: 260px;
    max-width: calc(100% - 40px);
    box-sizing: border-box;
    padding: 22px;
    background: var(--paper-0);
    color: var(--ink-900);
    box-shadow: 0 0 0 1px var(--paper-300);
  }
  .card p {
    margin: 0;
  }
  .card-title {
    margin-bottom: 6px !important;
    font-weight: 700;
    font-size: 18px;
  }
  .card-text {
    margin-bottom: 18px !important;
    font-size: 14px;
    color: var(--ink-700);
  }
  .card-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 46px;
    color: var(--paper-0);
    font-weight: 600;
  }
  .baseline-card,
  .baseline-card .card-cta {
    border-radius: 6px;
  }
  .baseline-card .card-cta {
    background: var(--blueprint-600);
  }
  .candidate-card,
  .candidate-card .card-cta {
    border-radius: 14px;
  }
  .candidate-card .card-cta {
    background: var(--blueprint-700);
  }
  .hot {
    display: none;
    position: absolute;
  }
  .show-overlay .hot {
    display: block;
  }
  .hot-cta {
    left: 22px;
    right: 22px;
    bottom: 22px;
    height: 46px;
    border-radius: 14px;
    background: repeating-linear-gradient(
      45deg,
      rgb(232 99 42 / 0.75) 0 4px,
      rgb(255 228 210 / 0.6) 4px 8px
    );
  }
  .hot-tl,
  .hot-br {
    width: 22px;
    height: 22px;
    border: 3px solid var(--redline-500);
  }
  .hot-tl {
    left: -2px;
    top: -2px;
    border-right: 0;
    border-bottom: 0;
    border-top-left-radius: 14px;
  }
  .hot-br {
    right: -2px;
    bottom: -2px;
    border-left: 0;
