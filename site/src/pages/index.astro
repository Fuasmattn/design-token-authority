---
/**
 * The landing page (spec: docs/specs/landing-redesign.md, revised 2026-10-26, TICKET-168): the hero
 * on the gravity well, the workflow at a glance, the commands, the facts, and the final call with
 * a few objects floating free. One surface, no grid. Everything on it is a design-system
 * component; this file and landing.css only place them. The frame (fonts, header, nav, theme
 * switch, footer) is SiteLayout, shared with the playground.
 */
import SiteLayout from '../layouts/SiteLayout.astro'
import '../styles/landing.css'
import Button from '../components/ds/Button.astro'
import CommandButton from '../components/ds/CommandButton.astro'
import Commands from '../components/ds/Commands.astro'
import Facts from '../components/ds/Facts.astro'
import FloatingObjects from '../components/ds/FloatingObjects.astro'
import GravityWell from '../components/ds/GravityWell.astro'
import SectionIntro from '../components/ds/SectionIntro.astro'
import Workflow from '../components/ds/Workflow.astro'
import {
  COMMANDS,
  COMMANDS_SECTION,
  COMMAND_GRID,
  FACTS,
  FINAL,
  HERO,
  WORKFLOW,
} from '../landing/content'

const title = 'Design Token Authority'
const description = `${HERO.headline} ${HERO.headlineAccent}`
const commandCells = COMMAND_GRID.map((cell) => ({ command: cell.command.text, text: cell.text }))
---

<SiteLayout title={title} description={description}>
    <main id="main">
      <GravityWell id="hero">
        <h1 id="hero-title">
          {HERO.headline} <i class="accent">{HERO.headlineAccent}</i>
        </h1>
        <p class="lede">{HERO.subline}</p>
        <div class="cta">
          <CommandButton command={COMMANDS.init.text} size="large" />
          <Button variant="outline" href={HERO.secondary.href}>{HERO.secondary.label}</Button>
        </div>
      </GravityWell>

      <div class="wrap how">
        <Workflow
          id="how"
          idPrefix="how"
          title={WORKFLOW.title}
          kicker={WORKFLOW.kicker}
          beats={WORKFLOW.beats}
          end={WORKFLOW.end}
        />
      </div>

      <section class="wrap plain" id="commands" aria-labelledby="commands-title">
        <SectionIntro
          kicker={COMMANDS_SECTION.kicker}
          heading={COMMANDS_SECTION.heading}
          link={COMMANDS_SECTION.link}
          headingId="commands-title"
        />
        <Commands commands={commandCells} />
      </section>

      <div class="wrap plain facts">
        <Facts facts={FACTS} />
      </div>

      <FloatingObjects id="final">
        <div class="wrap final">
          <h2>{FINAL.heading}</h2>
          <p>{FINAL.text}</p>
          <CommandButton command={COMMANDS.init.text} size="large" />
        </div>
      </FloatingObjects>
    </main>

</SiteLayout>
