---
/**
 * The landing page (spec: docs/specs/landing-redesign.md, revised 2026-10-18): the hero on the
 * gravity well, one change in four scenes with the Orbit Burger example, the facts, and the final
 * call with a few objects floating free. One surface, no grid. Everything on it is a design-system
 * component; this file and landing.css only place them.
 */
import '../../output/css/base.css'
import '../../output/css/themes/light.css'
import '../../output/css/themes/graphite.css'
import '../../output/css/examples/orbit-burger.css'
import '../styles/fonts.css'
import '../styles/landing.css'
import sansUrl from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wdth-normal.woff2?url'
import sansItalicUrl from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wdth-italic.woff2?url'
import monoUrl from '@fontsource-variable/martian-mono/files/martian-mono-latin-wght-normal.woff2?url'
import Button from '../components/ds/Button.astro'
import Checks from '../components/ds/Checks.astro'
import CommandButton from '../components/ds/CommandButton.astro'
import ExampleButton from '../components/ds/ExampleButton.astro'
import Facts from '../components/ds/Facts.astro'
import FloatingObjects from '../components/ds/FloatingObjects.astro'
import GravityWell from '../components/ds/GravityWell.astro'
import Logo from '../components/ds/Logo.astro'
import Nav from '../components/ds/Nav.astro'
import Scene from '../components/ds/Scene.astro'
import Terminal from '../components/ds/Terminal.astro'
import ThemeSwitch from '../components/ds/ThemeSwitch.astro'
import TokenRows from '../components/ds/TokenRows.astro'
import {
  AGENT_RUN,
  APPROVE,
  CHECKS,
  COMMANDS,
  DIFF_SHARES,
  FACTS,
  FINAL,
  HERO,
  SCENES,
  TOKEN_ROWS,
} from '../landing/content'

const title = 'Design Token Authority'
const description = `${HERO.headline} ${HERO.headlineAccent}`
const github = 'https://github.com/Fuasmattn/design-token-authority'
const NAV = [
  { href: '#story', label: 'How it works' },
  { href: '#agents', label: 'Agents' },
  { href: '/start/', label: 'Docs' },
]
const [s1, s2, s3, s4] = SCENES
---

<!doctype html>
<html lang="en" data-theme="light" data-brand="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={sansUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansItalicUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoUrl} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Same theme as the docs: Starlight keeps the choice in localStorage ('light' | 'dark').
      ;(() => {
        let stored = null
        try {
          stored = localStorage.getItem('starlight-theme')
        } catch {}
        const dark =
          stored === 'dark' ||
          ((!stored || stored === 'auto') && matchMedia('(prefers-color-scheme: dark)').matches)
        document.documentElement.dataset.theme = dark ? 'dark' : 'light'
        document.documentElement.dataset.brand = dark ? 'graphite' : 'light'
      })()
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <Logo />
      <Nav links={NAV} idPrefix="site">
        <ThemeSwitch />
      </Nav>
    </header>

    <main id="main">
      <GravityWell id="hero">
        <h1 id="hero-title">
          {HERO.headline} <i class="accent">{HERO.headlineAccent}</i>
        </h1>
        <p class="lede">{HERO.subline}</p>
        <div class="cta">
          <CommandButton command={COMMANDS.init.text} size="large" />
          <Button variant="outline" href={HERO.secondary.href}>{HERO.secondary.label}</Button>
        </div>
      </GravityWell>

      <div class="wrap story" id="story">
        <Scene
          number={s1.number}
          kicker={s1.kicker}
          heading={s1.heading}
          text={s1.text}
          command={s1.command.text}
          example="right"
        >
          <TokenRows rows={TOKEN_ROWS} />
        </Scene>

        <Scene
          number={s2.number}
          kicker={s2.kicker}
          heading={s2.heading}
          text={s2.text}
          command={s2.command.text}
          example="left"
        >
          <div class="two-states">
            <div class="pair">
              <ExampleButton state="main" label="main" />
              <ExampleButton state="change" label="this change" />
            </div>
            <ul class="shares">
              {
                DIFF_SHARES.lines.map((line) => (
                  <li>
                    <span class="token">{line.token}</span> {line.change} · {line.share}
                  </li>
                ))
              }
              <li class="note">{DIFF_SHARES.note}</li>
            </ul>
          </div>
        </Scene>

        <Scene
          number={s3.number}
          kicker={s3.kicker}
          heading={s3.heading}
          text={s3.text}
          command={s3.command.text}
          example="right"
        >
          <Checks checks={CHECKS} approve={APPROVE} />
        </Scene>

        <Scene
          number={s4.number}
          kicker={s4.kicker}
          heading={s4.heading}
          text={s4.text}
          command={s4.command.text}
          example="left"
          id="agents"
        >
          <div class="agent">
            <Terminal lines={AGENT_RUN.lines} label={AGENT_RUN.label} />
            <p class="caption">Real output, from this website's own tokens.</p>
          </div>
        </Scene>

        <Facts facts={FACTS} />
      </div>

      <FloatingObjects id="final">
        <div class="wrap final">
          <h2>{FINAL.heading}</h2>
          <p>{FINAL.text}</p>
          <CommandButton command={COMMANDS.init.text} size="large" />
        </div>
      </FloatingObjects>
    </main>

    <footer class="foot">
      <div class="wrap foot-inner">
        <span>Design Token Authority · MIT</span>
        <nav aria-label="Footer">
          <a href="/start/">Docs</a>
          <a href="/reference/">CLI reference</a>
          <a href={github}>GitHub</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
