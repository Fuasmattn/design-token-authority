---
/**
 * The frame of the site's standalone pages (the landing page, the playground; spec
 * docs/specs/playground.md decision 12): token CSS, both themes, the fonts, the header with the
 * logo, the navigation and the theme switch, and the footer. The page fills the default slot
 * with its `<main id="main">` and imports its own stylesheet after this layout, so the page's
 * file only places components (src/styles/site.css holds the shared frame).
 */
import '../../output/css/base.css'
import '../../output/css/themes/light.css'
import '../../output/css/themes/graphite.css'
import '../styles/fonts.css'
import '../styles/site.css'
import sansUrl from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wdth-normal.woff2?url'
import sansItalicUrl from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wdth-italic.woff2?url'
import monoUrl from '@fontsource-variable/martian-mono/files/martian-mono-latin-wght-normal.woff2?url'
import Logo from '../components/ds/Logo.astro'
import Nav from '../components/ds/Nav.astro'
import ThemeSwitch from '../components/ds/ThemeSwitch.astro'

interface Props {
  title: string
  description: string
}
const { title, description } = Astro.props
const github = 'https://github.com/Fuasmattn/design-token-authority'
// The landing page's sections are anchors on the page itself; elsewhere they lead back to it.
// The link of the page shown is current (Nav); the landing page's sections never are.
const path = Astro.url.pathname
const home = path === '/'
const NAV = [
  { href: home ? '#how' : '/#how', label: 'How it works' },
  { href: home ? '#agents' : '/#agents', label: 'Agents' },
  { href: '/playground/', label: 'Playground' },
  { href: '/start/', label: 'Docs' },
].map((link) => ({ ...link, current: !link.href.includes('#') && path.startsWith(link.href) }))
---

<!doctype html>
<html lang="en" data-theme="light" data-brand="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={sansUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansItalicUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoUrl} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Same theme as the docs: Starlight keeps the choice in localStorage ('light' | 'dark').
      ;(() => {
        let stored = null
        try {
          stored = localStorage.getItem('starlight-theme')
        } catch {}
        const dark =
          stored === 'dark' ||
          ((!stored || stored === 'auto') && matchMedia('(prefers-color-scheme: dark)').matches)
        document.documentElement.dataset.theme = dark ? 'dark' : 'light'
        document.documentElement.dataset.brand = dark ? 'graphite' : 'light'
      })()
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <Logo />
      <Nav links={NAV} idPrefix="site">
        <ThemeSwitch />
      </Nav>
    </header>

    <slot />

    <footer class="foot">
      <div class="wrap foot-inner">
        <span>Design Token Authority · MIT</span>
        <nav aria-label="Footer">
          <a href="/start/">Docs</a>
          <a href="/playground/">Playground</a>
          <a href="/reference/">CLI reference</a>
          <a href={github}>GitHub</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
