---
import WorkflowList from '../components/ds/WorkflowList.astro'

interface Props {
  idPrefix: string
}
const { idPrefix } = Astro.props
---

<WorkflowList
  idPrefix={idPrefix}
  title="How it works"
  change={{
    side: 'where the change is made',
    label: 'Change',
    text: 'In Figma Variables, in a token file, or by an agent.',
  }}
  crossing={{ command: 'dta pull', text: 'into the repository' }}
  pullRequest="in the pull request"
  steps={[
    { label: 'Check', text: 'Structure and names, against your rules.', command: 'dta lint' },
    { label: 'Build', text: 'Every output, for every brand and mode.', command: 'dta build' },
    { label: 'Diff', text: 'Before and after, each difference named by token.', command: 'dta diff' },
    { label: 'Decide', text: 'A person approves by token.' },
  ]}
  back={{
    text: 'A fix goes back to whichever side caused it: a value in Figma, or a component in code.',
    command: 'dta audit',
    detail: 'finds the hard-coded ones',
  }}
/>
