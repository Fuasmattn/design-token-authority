---
import DiffCard from '../components/ds/DiffCard.astro'
import { CARD_CANVAS, ORBIT_MARKS, ORBIT_TOKENS, orbitCard } from './orbit-card'

interface Props {
  idPrefix?: string
}
const { idPrefix = 'diff-card-before' } = Astro.props
---

<DiffCard
  story="orbit-card--default"
  viewport={1280}
  ratio="0.83%"
  base="main · 2ee9b31"
  canvas={CARD_CANVAS}
  marks={ORBIT_MARKS}
  tokens={ORBIT_TOKENS}
  showBefore
  idPrefix={idPrefix}
>
  <Fragment slot="after" set:html={orbitCard({ radius: 24, button: '#3d87e8' })} />
  <Fragment slot="before" set:html={orbitCard({ radius: 8, button: '#5aa2ff' })} />
</DiffCard>
