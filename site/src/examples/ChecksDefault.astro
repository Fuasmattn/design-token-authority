---
// The checks of a pull request in the workflow's order: lint, build, then the diff waiting for a person.
import Checks from '../components/ds/Checks.astro'

const checks = [
  { name: 'dta lint', status: 'passed' as const, detail: '0 violations' },
  { name: 'dta build', status: 'passed' as const },
  { name: 'dta diff', status: 'changes' as const, detail: '6 stories' },
]
---

<Checks checks={checks} />
