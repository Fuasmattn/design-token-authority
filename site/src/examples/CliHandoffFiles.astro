---
// Real output: the config the playground generates for the brand-ab example, and the steps.
import CliHandoff from '../components/ds/CliHandoff'
import { cliSteps } from '../playground/outputs'
import { exampleOutputs } from './outputs-example'

interface Props {
  idPrefix?: string
}
const { idPrefix = 'cli-files' } = Astro.props
const { config } = await exampleOutputs()
---

<CliHandoff
  idPrefix={idPrefix}
  intro="The same files on your machine: the generated config carries the choices above."
  config={config}
  steps={cliSteps({})}
  note="The config imports defineConfig from design-token-authority: install it in your project first (npm install --save-dev design-token-authority)."
/>
