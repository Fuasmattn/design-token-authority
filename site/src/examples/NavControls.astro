---
import IconButton from '../components/ds/IconButton.astro'
import Nav from '../components/ds/Nav.astro'
import ThemeSwitch from '../components/ds/ThemeSwitch.astro'

interface Props {
  idPrefix: string
}
const { idPrefix } = Astro.props
const links = [
  { href: '#how', label: 'How it works' },
  { href: '#review', label: 'Review' },
  { href: '#use', label: 'Use cases' },
  { href: '/start/', label: 'Docs' },
]
---

<Nav links={links} idPrefix={idPrefix}>
  <IconButton icon="github" label="GitHub repository" href="#github" />
  <IconButton icon="npm" label="npm package" href="#npm" />
  <ThemeSwitch />
</Nav>
