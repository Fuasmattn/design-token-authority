# The @dta/build package is source code, not build output
!packages/build
# Parity fixtures are committed on purpose (see test/fixtures/README.md)
!test/fixtures/**/tokens
!test/fixtures/**/dta.config.ts
# Reference snapshots are committed on purpose, including build/, output/ and tokens/ inside them
!test/snapshots/**
# The website's design tokens and their config are source
!site/tokens
!site/dta.config.ts
# Learn example projects are source (tested in site/learn-examples.test.ts)
!site/learn-examples/**/dta.config.ts
